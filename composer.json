{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "hyper-commerce/platform",
    "type": "project",
    "description": "Hyper Commerce Platform",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "brick/money": "^0.14.2",
        "laravel/framework": "^13.0",
        "laravel/pennant": "^1.26",
        "laravel/reverb": "^1.11",
        "laravel/sanctum": "^4.3",
        "laravel/scout": "^11.6",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.4",
        "meilisearch/meilisearch-php": "^1.17",
        "predis/predis": "^3.6",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-medialibrary": "^11.23",
        "spatie/laravel-permission": "^8.3",
        "stevebauman/purify": "^6.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\": "modules/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "bin-compat": "full"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
